<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/winter_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_winter_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: WINTER ARC & Quick Check-in Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WINTER ARC"
                android:textColor="#FF9F0A"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/winter_widget_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00 сом"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/winter_widget_btn_checkin"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_winter_bg"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Отметить"
            android:textColor="#161412"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Days of Week Headers (Пн Вт Ср Чт Пт Сб Вс) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day_hdr_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Пн"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Вт"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ср"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Чт"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Пт"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сб"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_hdr_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Вс"
            android:textColor="#8E8E93"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 1: 7 Habit Squares with spacious 4dp horizontal margins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sq_1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_2"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_3"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_4"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_today_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#161412"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_5"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_6"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_7"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />
    </LinearLayout>

    <!-- Row 2: 7 Habit Squares with spacious 7dp top margin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sq_8"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_9"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sq_10"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_11"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_12"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_13"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />

        <TextView
            android:id="@+id/sq_14"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_square_empty" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Footer: "X дн. без спонтанных трат" -->
    <TextView
        android:id="@+id/winter_widget_streak_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 дн. без спонтанных трат"
        android:textColor="#FF9F0A"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
