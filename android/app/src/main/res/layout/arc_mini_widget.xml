<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ARC FINANCE"
            android:textColor="#8E8E93"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KGS"
            android:textColor="#636366"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Balance Section -->
    <TextView
        android:id="@+id/widget_mini_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Баланс кошелька"
        android:textColor="#A1A1A6"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_mini_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="0,00 сом"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_mini_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Сегодня: без трат"
        android:textColor="#8E8E93"
        android:textSize="9.5sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Button -->
    <TextView
        android:id="@+id/widget_mini_btn_expense"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@drawable/widget_btn_expense_bg"
        android:gravity="center"
        android:text="− Расход"
        android:textColor="#FF453A"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
